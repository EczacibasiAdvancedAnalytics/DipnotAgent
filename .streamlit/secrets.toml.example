# Streamlit Community Cloud secrets şablonu.
# Bu dosyayı kopyalamayın: share.streamlit.io → uygulamanız →
#   App settings → Secrets  alanına yapıştırıp GERÇEK değerleri doldurun.
# Anahtar adları .env ile aynıdır; src/config.py st.secrets'ı ortam değişkeni olarak okur.
# Gerçek anahtarları bu örneğe yazmayın ve git'e koymayın (.streamlit/secrets.toml yok sayılır).
#
# Cloud'da `az login` / DefaultAzureCredential çalışmaz. API anahtarları zorunludur.
# Login: APP_AUTH_USER ve APP_AUTH_PASSWORD doldurulursa giriş ekranı açılır.

# --- Azure AI Search (zorunlu) ---
AZURE_SEARCH_ENDPOINT = "https://<arama-servisi>.search.windows.net"
AZURE_SEARCH_INDEX = "<indeks-adi>"
AZURE_SEARCH_API_KEY = "<search-api-key>"
AZURE_SEARCH_SEMANTIC_CONFIG = ""

# Alan eşlemesi (boş bırakılırsa indeks şemasından keşfedilir)
SEARCH_FIELD_CONTENT = ""
SEARCH_FIELD_TITLE = ""
SEARCH_FIELD_URL = ""
SEARCH_FIELD_LAST_MODIFIED = ""
SEARCH_FIELD_FILE_TYPE = ""
SEARCH_FIELD_VECTOR = ""

# --- Azure OpenAI / direct motor (zorunlu) ---
AZURE_OPENAI_ENDPOINT = "https://<aoai-kaynagi>.openai.azure.com"
AZURE_OPENAI_CHAT_DEPLOYMENT = "gpt-4o"
AZURE_OPENAI_API_KEY = "<azure-openai-api-key>"
AZURE_OPENAI_API_VERSION = "2024-10-21"
AZURE_OPENAI_EMBEDDING_DEPLOYMENT = "text-embedding-3-large"

# --- Motor seçimi ---
RAG_BACKEND = "direct"

# --- Microsoft Foundry (opsiyonel; RAG_BACKEND=foundry ise doldurun) ---
FOUNDRY_PROJECT_ENDPOINT = ""
FOUNDRY_MODEL_DEPLOYMENT = ""
FOUNDRY_SEARCH_CONNECTION_NAME = ""
FOUNDRY_AGENT_ID = ""
FOUNDRY_AGENT_NAME = "sharepoint-knowledge-agent"
FOUNDRY_QUERY_TYPE = "vector_semantic_hybrid"

# --- Cevap davranışı ---
RAG_TOP_K = "12"
RAG_CANDIDATE_COUNT = "48"
RAG_TEMPERATURE = "0.0"
RAG_MAX_TOKENS = "1500"
RAG_REASONING_BUDGET = "2000"
RAG_MAX_CHARS_PER_DOC = "4000"
RAG_MIN_RERANKER_SCORE = "2.0"
RAG_MERGE_CHUNKS = "true"
RAG_HISTORY_TURNS = "4"
RAG_REWRITE_QUERY = "true"
WEB_FETCH_ENABLED = "true"
WEB_FETCH_MAX_PER_QUESTION = "6"

# --- Arayüz ---
APP_TITLE = "Dipnot"
APP_SUBTITLE = "Kitap yazarken SharePoint arşivinden kaynak ve atıf."
SHAREPOINT_SITE_URL = ""
SHAREPOINT_DOC_LIBRARY = "Shared Documents"
SHAREPOINT_LINK_MODE = "browse"
APP_SHOW_ADVANCED_TABS = "false"
APP_CHAT_DB_PATH = ""

# --- Uygulama girişi (Cloud'da doldurun) ---
APP_AUTH_USER = "<kullanici>"
APP_AUTH_PASSWORD = "<sifre>"
