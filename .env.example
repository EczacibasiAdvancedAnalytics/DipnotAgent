# ============================================================
#  SharePoint Knowledge Assistant - yapılandırma
#  Bu dosyayı ".env" olarak kopyalayıp değerleri doldurun.
# ============================================================

# Hangi motor kullanılacak: "direct" (Azure AI Search + Azure OpenAI) veya "foundry" (Foundry Agent Service)
RAG_BACKEND=direct


# ------------------------------------------------------------
# 1) Azure AI Search  (her iki motor için gerekli)
# ------------------------------------------------------------
AZURE_SEARCH_ENDPOINT=https://srch-hld-dev-aa-02.search.windows.net
# Hibrit + semantik indeks. Eski metin indeksi (silmeyin): fe-partial-data-index
AZURE_SEARCH_INDEX=fe-partial-data-vector-index
# Boş bırakırsanız Entra ID (DefaultAzureCredential / az login) kullanılır.
# Streamlit Community Cloud'da az login çalışmaz; API anahtarı zorunludur.
AZURE_SEARCH_API_KEY=

# Genelde boş bırakın; indeks şemasından otomatik bulunur.
AZURE_SEARCH_SEMANTIC_CONFIG=

# Alan eşlemesini elle sabitlemek isterseniz doldurun (aksi halde otomatik keşfedilir).
# SharePoint indexer varsayılanları: metadata_spo_item_name / content / metadata_spo_item_weburi
SEARCH_FIELD_CONTENT=
SEARCH_FIELD_TITLE=
SEARCH_FIELD_URL=
SEARCH_FIELD_LAST_MODIFIED=
SEARCH_FIELD_FILE_TYPE=
# Virgülle ayrılmış vektör alan adları (örn. contentVector,text_vector)
SEARCH_FIELD_VECTOR=


# ------------------------------------------------------------
# 2) Azure OpenAI  (RAG_BACKEND=direct için gerekli)
# ------------------------------------------------------------
AZURE_OPENAI_ENDPOINT=https://hld-ai-sandbox-advanced-resource.openai.azure.com/openai/v1
AZURE_OPENAI_CHAT_DEPLOYMENT=gpt-5.2
# Boş bırakırsanız Entra ID kullanılır. Cloud'da API anahtarı zorunludur.
AZURE_OPENAI_API_KEY=
AZURE_OPENAI_API_VERSION=2024-10-21
# İndekste vectorizer tanımlı DEĞİLSE, hibrit arama için embedding deployment adı.
# Vektör indeksi kurulurken (scripts/build_vector_index.py) de bu deployment kullanılır.
AZURE_OPENAI_EMBEDDING_DEPLOYMENT=text-embedding-3-large


# ------------------------------------------------------------
# 3) Microsoft Foundry Agent Service  (RAG_BACKEND=foundry için gerekli)
# ------------------------------------------------------------
FOUNDRY_PROJECT_ENDPOINT=https://hld-ai-sandbox-advanced-resource.services.ai.azure.com/api/projects/hld-ai-sandbox-advancedanalytics
FOUNDRY_MODEL_DEPLOYMENT=gpt-5.2
# Foundry projesindeki Azure AI Search bağlantısının adı
FOUNDRY_SEARCH_CONNECTION_NAME=fe-partial-data
# Var olan bir agent'ı tekrar kullanmak için ID girin; boşsa isimden bulunur veya oluşturulur.
FOUNDRY_AGENT_ID=
FOUNDRY_AGENT_NAME=Kitap-Agent
# simple | semantic | vector | vector_simple_hybrid | vector_semantic_hybrid
FOUNDRY_QUERY_TYPE=vector_semantic_hybrid


# ------------------------------------------------------------
# 4) Cevap davranışı
# ------------------------------------------------------------
# Modele gönderilecek kaynak üst sınırı (arama tüm arşivi tarar)
RAG_TOP_K=12
# Azure Search'ten çekilecek aday havuzu (reranker buradan eleyerek üst sınıra iner)
RAG_CANDIDATE_COUNT=48
RAG_TEMPERATURE=0.0
RAG_MAX_TOKENS=1500
# Akıl yürütme (reasoning) modelleri için ek token payı. gpt-5 gibi modeller görünmeyen
# düşünme adımlarında da token harcar; bu pay olmazsa yanıt boş dönebilir.
# Klasik modellerde (gpt-4o vb.) kullanılmaz.
RAG_REASONING_BUDGET=2000
# Doküman başına maksimum karakter (uzun dosyaları kırpar)
RAG_MAX_CHARS_PER_DOC=4000
# Semantik reranker skoru bu değerin altındaki sonuçları at (0 = filtreleme yok, tipik aralık 0-4)
RAG_MIN_RERANKER_SCORE=2.0
# Aynı dokümanın birden fazla parçasını (chunk) tek referansta birleştir
RAG_MERGE_CHUNKS=true
# Sohbet geçmişinden modele taşınacak tur sayısı
RAG_HISTORY_TURNS=4
# Takip sorularını ("peki onun süresi ne kadar?") bağımsız arama sorgusuna çevir
RAG_REWRITE_QUERY=true
# .msg e-postalarında asıl metin yoksa, abonelik gerektirmeyen açık web sayfalarını çek
WEB_FETCH_ENABLED=true
# Bir soruda en fazla kaç web sayfası çekilsin
WEB_FETCH_MAX_PER_QUESTION=6


# ------------------------------------------------------------
# 5) Arayüz
# ------------------------------------------------------------
APP_TITLE=Dipnot
APP_SUBTITLE=Kitap yazarken SharePoint arşivinden kaynak ve atıf.
# Göreli yol tutan indeksler için tam SharePoint linki üretmekte kullanılır.
# örn. https://contoso.sharepoint.com/sites/Kalite
SHAREPOINT_SITE_URL=
# İndekste Graph yolu (/drives/.../root:/...) varsa dokümanların bulunduğu kitaplık adı.
# Türkçe arayüzlü sitelerde "Belgeler", İngilizce sitelerde "Shared Documents" olabilir.
SHAREPOINT_DOC_LIBRARY=Shared Documents
# Referans bağlantısı nasıl açılsın?
#   browse (varsayılan) : dosyayı SharePoint web arayüzünde, klasörü açık ve dosya seçili gösterir
#                         (.../Shared%20Documents/Forms/AllItems.aspx?id=...&parent=...)
#   direct              : dosyanın kendi adresini verir; tarayıcı çoğu dosya türünü indirir
# Referans kartında her iki seçenek de sunulur; bu ayar yalnızca birincil bağlantıyı belirler.
SHAREPOINT_LINK_MODE=browse
# Teknik sekmeleri (Kaynak tarayıcı, Tanılama) göster. Son kullanıcıda kapalı bırakın.
APP_SHOW_ADVANCED_TABS=false
# Sohbet geçmişinin tutulduğu SQLite dosyası (boşsa: data/chats.db)
APP_CHAT_DB_PATH=

# Uygulama girişi. Şifre boşsa login ekranı çıkmaz; doluysa zorunludur.
# Cloud'da mutlaka doldurun (Streamlit Secrets: APP_AUTH_USER / APP_AUTH_PASSWORD).
APP_AUTH_USER=
APP_AUTH_PASSWORD=
